# ─── NL2SQL Engine — Environment Variables ───────────────────────────────────

# Database to run NL queries against
DATABASE_URL=postgresql+asyncpg://postgres:Jainish_2005@localhost:5432/business_os2

# Separate SQLite store for query log (few-shot memory)
# Leave as default to use a local SQLite file
LOG_DB_URL=sqlite+aiosqlite:///./nl2sql_log.db

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text


# API security (set a strong secret in production)
API_KEY=change-me-in-production

# App settings
APP_ENV=development
LOG_LEVEL=INFO
MAX_ROWS=500
MAX_TOOL_ROUNDS=5

# Rate limiting (requests per minute per IP)
RATE_LIMIT=60
